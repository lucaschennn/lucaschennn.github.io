# Copy to .env.local (local dev) or set in Vercel. Never commit real values.

# Numeric GitHub user ID allowed to sign in: curl https://api.github.com/users/<username> -> "id"
ALLOWED_GITHUB_ID=

# GitHub OAuth app (client ID and secret). Separate apps for localhost and production.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Encrypts session cookies: npx auth secret
AUTH_SECRET=

# Fine-grained PAT, this repo only: Contents read/write, Deployments read, Actions read
GITHUB_REPO_TOKEN=

NEXT_PUBLIC_CLOUDINARY_CLOUD=dch9wtpmk
