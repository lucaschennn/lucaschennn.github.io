{
  "name": "skyview",
  "private": true,
  "version": "1.0.0",
  "description": "Admin backend for rearranging and publishing the portfolio site",
  "scripts": {
    "dev": "npm run build:preview && next dev",
    "build": "npm run build:preview && next build",
    "start": "next start",
    "build:preview": "node ../node_modules/vite/bin/vite.js build --config preview/vite.config.mjs",
    "vercel-build": "npm ci --prefix .. --include=dev && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
